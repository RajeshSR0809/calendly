/**
 * In a scheduling application (like Calendly or Cal.com), defining availability rules is only half the battle.
 * The Booking model serves as the ultimate source of truth for an actual, confirmed, or pending transaction
 * between a host (the user) and a client (the invitee).
 * When a client selects an open time window generated by the availability engine, this model locks that slot down.
 * It prevents double-bookings, tracks the lifecycle of the meeting (e.g., from pending approval to cancelled),
 * holds critical guest information, and stores integration tokens (like Google Meet or Outlook IDs)
 * so your backend can synchronize seamlessly with external calendar ecosystems.
 */
model Booking {
  id Int @id @default(autoincrement())

  hostId      Int
  slotId      Int
  eventTypeId Int
  status      String @default("PENDING")

  inviteeEmail  String
  inviteeName   String
  inviteeeNotes String?

  meetLink        String?
  calendarEventId String?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  slot      Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([inviteeEmail])
  @@index([hostId, createdAt])
  @@map("bookings")
}
